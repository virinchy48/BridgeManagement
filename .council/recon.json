  "services": [
    {
      "name": "AdminService",
      "file": "srv/admin-service.cds",
      "requires": "authenticated-user (delegated to entity @restrict)",
      "events": ["CREATE","UPDATE","DELETE","READ","deactivate","reactivate","submitForReview","approveSurvey","rejectSurvey","approve","rejectPermit","supersede","disableRestriction","enableRestriction","createTemporaryRestriction","renewGazette","scoreAllBridges","refreshKPISnapshots","loadDemoData","clearDemoData","acknowledge","resolveAlert","suppress"],
      "notes": "Draft-enabled for Bridges only; 133 handler registrations in admin-service.js"
    },
    {
      "name": "BridgeManagementService",
      "file": "srv/service.cds + srv/services/*.cds",
      "requires": "authenticated-user (entity-level @restrict)",
      "events": ["CREATE","UPDATE","DELETE","READ","deactivate","reactivate","disableRestriction","enableRestriction","createTemporaryRestriction","renewGazette","geocodeAddress","reverseGeocode","getMapApiConfig","massUploadBridges","massUploadRestrictions","massDownloadBridges","massEditBridges","acknowledge","resolveAlert","suppress","getNetworkKPIs","getConditionDistribution","getNetworkRiskSummary","getHighRiskBridges","getExpiringCertificates","getNhvrComplianceRate","exportNhvrPortalJson"],
      "notes": "Main CAP service; draft-enabled on nhvr.Bridge projection; separate from AdminService handlers"
    },
    {
      "name": "AnalyticsService",
      "file": "srv/services/analytics.cds",
      "requires": "view,inspect,manage,admin,executive_view",
      "events": ["READ"],
      "notes": "Read-only SELECT-based views: BridgePortfolio, InspectionHistory, DefectRegister, RiskRegister, AssetHealthScores, NetworkKPIs"
    },
    {
      "name": "PublicBridgeService",
      "file": "srv/services/public-bridge.cds",
      "requires": "any",
      "events": ["READ"],
      "notes": "Unauthenticated read-only; xs-app.json must have unauthenticated route before catch-all"
    }
  ],
