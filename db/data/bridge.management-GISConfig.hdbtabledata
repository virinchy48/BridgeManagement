          "ENABLEPROXIMITY",
          "ENABLEMGACOORDS",
          "ENABLESTREETVIEW",
          "ENABLECONDITIONALERTS",
          "ENABLECUSTOMWMS",
          "ENABLESERVERCLUSTERING",
          "CONDITIONALERTTHRESHOLD",
          "PROXIMITYDEFAULTRADIUSKM",
          "HEATMAPRADIUS",
          "HEATMAPBLUR",
          "VIEWPORTLOADINGZOOM",
          "CUSTOMWMSLAYERS"
        ],
        "include_filter": [],
        "upsert": true
      },
      "column_mappings": {
        "ID": "id",
        "DEFAULTBASEMAP": "defaultBasemap",
        "HEREAPIKEY": "hereApiKey",
        "SHOWSTATEBOUNDARIES": "showStateBoundaries",
        "SHOWLGABOUNDARIES": "showLgaBoundaries",
        "ENABLESCALEBAR": "enableScaleBar",
        "ENABLEGPS": "enableGps",
        "ENABLEMINIMAP": "enableMinimap",
        "ENABLEHEATMAP": "enableHeatmap",
        "ENABLETIMESLIDER": "enableTimeSlider",
        "ENABLESTATSPANEL": "enableStatsPanel",
        "ENABLEPROXIMITY": "enableProximity",
        "ENABLEMGACOORDS": "enableMgaCoords",
        "ENABLESTREETVIEW": "enableStreetView",
        "ENABLECONDITIONALERTS": "enableConditionAlerts",
        "ENABLECUSTOMWMS": "enableCustomWms",
        "ENABLESERVERCLUSTERING": "enableServerClustering",
        "CONDITIONALERTTHRESHOLD": "conditionAlertThreshold",
        "PROXIMITYDEFAULTRADIUSKM": "proximityDefaultRadiusKm",
        "HEATMAPRADIUS": "heatmapRadius",
        "HEATMAPBLUR": "heatmapBlur",
        "VIEWPORTLOADINGZOOM": "viewportLoadingZoom",
        "CUSTOMWMSLAYERS": "customWmsLayers"
      }
